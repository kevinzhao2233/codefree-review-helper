{
  "name": "codefree-review-helper",
  "version": "0.6.2",
  "description": "Split large PR diffs into reviewable sub-patches via indexed groups.",
  "homepage": "https://github.com/neutree-ai/reviewdeck",
  "bugs": {
    "url": "https://github.com/neutree-ai/reviewdeck/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/neutree-ai/reviewdeck.git"
  },
  "bin": {
    "codefree-review-helper": "dist/codefree-review-helper.mjs"
  },
  "files": [
    "dist/codefree-review-helper.mjs",
    "dist/web",
    "dist/ui",
    "skills/codefree-review-helper",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./ui": {
      "import": "./dist/ui/reviewdeck-ui.js"
    },
    "./ui/style.css": "./dist/ui/style.css"
  },
  "scripts": {
    "test": "vp test",
    "check": "vp check",
    "check-deps": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "build:cli": "esbuild src/cli/main.ts --bundle --platform=node --format=esm --outfile=dist/codefree-review-helper.mjs --banner:js=\"#!/usr/bin/env node\"",
    "build:web": "vp build -c src/web/vite.config.ts",
    "build:ui": "vp build -c src/web/vite.config.lib.ts",
    "build": "npm run build:cli && npm run build:web && npm run build:ui",
    "lint": "vp test && vp check && knip && depcruise src --config .dependency-cruiser.cjs",
    "pack:dry-run": "npm pack --dry-run",
    "prepack": "npm run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "@pierre/diffs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "dependency-cruiser": "^17.3.9",
    "esbuild": "^0.27.4",
    "knip": "^5.86.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "vite-plus": "1.7.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.11.1"
}
